sult"},"data":{"$ref":"#/$defs/DelegateResult"},"runtimeConformance":{"const":false}},"required":["profile","kind","data","runtimeConformance"],"additionalProperties":false},{"type":"object","properties":{"profile":{"const":"urn:prometheus:uar:team-execution:0.1.0"},"kind":{"const":"Diagnostic"},"data":{"$ref":"#/$defs/Diagnostic"},"runtimeConformance":{"const":false}},"required":["profile","kind","data","runtimeConformance"],"additionalProperties":false},{"type":"object","properties":{"profile":{"const":"urn:prometheus:uar:team-execution:0.1.0"},"kind":{"const":"WaitRequest"},"data":{"$ref":"#/$defs/WaitRequest"},"runtimeConformance":{"const":false}},"required":["profile","kind","data","runtimeConformance"],"additionalProperties":false},{"type":"object","properties":{"profile":{"const":"urn:prometheus:uar:team-execution:0.1.0"},"kind":{"const":"WaitAccepted"},"data":{"$ref":"#/$defs/WaitAccepted"},"runtimeConformance":{"const":false}},"required":["profile","kind","data","runtimeConformance"],"additionalProperties":false},{"type":"object","properties":{"profile":{"const":"urn:prometheus:uar:team-execution:0.1.0"},"kind":{"const":"TeamWait"},"data":{"$ref":"#/$defs/TeamWait"},"runtimeConformance":{"const":false}},"required":["profile","kind","data","runtimeConformance"],"additionalProperties":false},{"type":"object","properties":{"profile":{"const":"urn:prometheus:uar:team-execution:0.1.0"},"kind":{"const":"KernelTeamYield"},"data":{"$ref":"#/$defs/KernelTeamYield"},"runtimeConformance":{"const":false}},"required":["profile","kind","data","runtimeConformance"],"additionalProperties":false},{"type":"object","properties":{"profile":{"const":"urn:prometheus:uar:team-execution:0.1.0"},"kind":{"const":"ContinuationReceipt"},"data":{"$ref":"#/$defs/ContinuationReceipt"},"runtimeConformance":{"const":false}},"required":["profile","kind","data","runtimeConformance"],"additionalProperties":false}],
  "$defs": {
    "Id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "Revision": {"type":"integer","minimum":1,"maximum":9007199254740991},
    "Counter": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "Digest": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "Instant": {"type":"string","format":"date-time","pattern":"Z$"},
    "Ref": {"type":"object","properties":{"id":{"$ref":"#/$defs/Id"},"revision":{"$ref":"#/$defs/Revision"}},"required":["id","revision"],"additionalProperties":false},
    "Scope": {"type":"object","properties":{"ownerId":{"$ref":"#/$defs/Id"},"workspaceId":{"$ref":"#/$defs/Id"},"teamId":{"$ref":"#/$defs/Id"}},"required":["ownerId","workspaceId","teamId"],"additionalProperties":false},
    "ExecutionFence": {"type":"object","properties":{"catalogId":{"$ref":"#/$defs/Id"},"serviceInstanceId":{"$ref":"#/$defs/Id"},"incarnationId":{"$ref":"#/$defs/Id"},"epoch":{"$ref":"#/$defs/Revision"}},"required":["catalogId","serviceInstanceId","incarnationId","epoch"],"additionalProperties":false},
    "ExecutionClaim": {"type":"object","properties":{"catalogId":{"$ref":"#/$defs/Id"},"serviceInstanceId":{"$ref":"#/$defs/Id"},"incarnationId":{"$ref":"#/$defs/Id"},"epoch":{"$ref":"#/$defs/Revision"},"state":{"enum":["held","draining","released"]},"acquiredAt":{"$ref":"#/$defs/Instant"},"auditReceiptId":{"$ref":"#/$defs/Id"},"releasedAt":{"$ref":"#/$defs/Instant"}},"required":["catalogId","serviceInstanceId","incarnationId","epoch","state","acquiredAt","auditReceiptId"],"additionalProperties":false},
    "ReclaimRequest": {"type":"object","properties":{"commandId":{"$ref":"#/$defs/Id"},"catalogId":{"$ref":"#/$defs/Id"},"expectedEpoch":{"$ref":"#/$defs/Revision"},"replacementServiceInstanceId":{"$ref":"#/$defs/Id"},"reason":{"type":"string","minLength":1,"maxLength":2048},"fencingEvidenceRef":{"$ref":"#/$defs/Id"}},"required":["commandId","catalogId","expectedEpoch","replacementServiceInstanceId","reason","fencingEvidenceRef"],"additionalProperties":false},
    "ReclaimReceipt": {"type":"object","properties":{"commandId":{"$ref":"#/$defs/Id"},"requestDigest":{"$ref":"#/$defs/Digest"},"authenticatedActorId":{"$ref":"#/$defs/Id"},"previousFence":{"$ref":"#/$defs/ExecutionFence"},"replacementFence":{"$ref":"#/$defs/ExecutionFence"},"authorizationDecisionRef":{"$ref":"#/$defs/Id"},"fencingEvidenceRef":{"$ref":"#/$defs/Id"},"transferredQueuedAttemptIds":{"type":"array","items":{"$ref":"#/$defs/Id"},"uniqueItems":true},"uncertainAttemptIds":{"type":"array","items":{"$ref":"#/$defs/Id"},"uniqueItems":true},"committedAt":{"$ref":"#/$defs/Instant"}},"required":["commandId","requestDigest","authenticatedActorId","previousFence","replacementFence","authorizationDecisionRef","fencingEvidenceRef","transferredQueuedAttemptIds","uncertainAttemptIds","committedAt"],"additionalProperties":false},
    "AttemptAuthority": {"type":"object","properties":{"ownerId":{"$ref":"#/$defs/Id"},"workspaceId":{"$ref":"#/$defs/Id"},"teamId":{"$ref":"#/$defs/Id"},"taskId":{"$ref":"#/$defs/Id"},"memberId":{"$ref":"#/$defs/Id"},"attemptId":{"$ref":"#/$defs/Id"},"runId":{"$ref":"#/$defs/Id"},"taskOwnershipEpoch":{"$ref":"#/$defs/Revision"},"memberRevision":{"$ref":"#/$defs/Revision"},"binding":{"$ref":"#/$defs/Ref"},"executionFence":{"$ref":"#/$defs/ExecutionFence"}},"required":["ownerId","workspaceId","teamId","taskId","memberId","attemptId","runId","taskOwnershipEpoch","memberRevision","binding","executionFence"],"additionalProperties":false},
    "RouteIdentity": {"type":"object","properties":{"providerId":{"$ref":"#/$defs/Id"},"modelId":{"type":"string","minLength":1,"maxLength":512}},"required":["providerId","modelId"],"additionalProperties":false},
    "PricingIdentity": {"type":"object","properties":{"providerId":{"type":"string","minLength":1,"maxLength":512},"modelId":{"type":"string","minLength":1,"maxLength":512},"catalogRevision":{"type":"string","minLength":1,"maxLength":512}},"required":["providerId","modelId","catalogRevision"],"additionalProperties":false},
    "ReasoningRequest": {"oneOf":[{"type":"object","properties":{"mode":{"const":"off"}},"required":["mode"],"additionalProperties":false},{"type":"object","properties":{"mode":{"const":"explicit"},"effort":{"enum":["none","low","medium","high","max"]}},"required":["mode","effort"],"additionalProperties":false}]},
    "ModelSettingsRequest": {"type":"object","properties":{"route":{"$ref":"#/$defs/RouteIdentity"},"profile":{"$ref":"#/$defs/Ref"},"expectedSettingsRevision":{"$ref":"#/$defs/Revision"},"reasoning":{"$ref":"#/$defs/ReasoningRequest"}},"required":["route","profile","expectedSettingsRevision"],"additionalProperties":false},
    "LimitMetadata": {"type":"object","properties":{"contextTokens":{"$ref":"#/$defs/Counter"},"outputTokens":{"$ref":"#/$defs/Counter"},"source":{"enum":["endpoint-profile","provider-catalog","operator-assertion","unknown"]},"sourceRevision":{"type":"string","minLength":1,"maxLength":512}},"required":["source"],"additionalProperties":false},
    "FitDisposition": {"oneOf":[{"type":"object","properties":{"mode":{"const":"settings-only"},"guaranteedFit":{"const":false},"reason":{"const":"count-or-framing-unqualified"}},"required":["mode","guaranteedFit","reason"],"additionalProperties":false},{"type":"object","properties":{"mode":{"const":"guaranteed-fit"},"guaranteedFit":{"const":true},"budgetContract":{"$ref":"#/$defs/Ref"},"countEvidenceRef":{"$ref":"#/$defs/Id"}},"required":["mode","guaranteedFit","budgetContract","countEvidenceRef"],"additionalProperties":false}]},
    "EffectiveModelReceipt": {"type":"object","properties":{"route":{"$ref":"#/$defs/RouteIdentity"},"wireModelAlias":{"type":"string","minLength":1,"maxLength":512},"pricingIdentity":{"$ref":"#/$defs/PricingIdentity"},"endpointKind":{"type":"string","minLength":1,"maxLength":512},"profile":{"$ref":"#/$defs/Ref"},"settingsRevision":{"$ref":"#/$defs/Revision"},"requestedReasoning":{"$ref":"#/$defs/ReasoningRequest"},"effectiveReasoning":{"$ref":"#/$defs/ReasoningRequest"},"support":{"const":"validated"},"supportEvidenceRef":{"$ref":"#/$defs/Id"},"limits":{"$ref":"#/$defs/LimitMetadata"},"fit":{"$ref":"#/$defs/FitDisposition"}},"required":["route","wireModelAlias","endpointKind","profile","settingsRevision","requestedReasoning","effectiveReasoning","support","supportEvidenceRef","limits","fit"],"additionalProperties":false},
    "Diagnostic": {"type":"object","properties":{"code":{"enum":["TEAM_PROFILE_UNSUPPORTED","TEAM_CAPABILITY_UNSUPPORTED","TEAM_EXECUTION_OWNER_CONFLICT","TEAM_EXECUTION_EPOCH_STALE","TEAM_RECLAIM_UNAUTHORIZED","TEAM_RECLAIM_EVIDENCE_REQUIRED","TEAM_SCOPE_DENIED","TEAM_EDGE_DENIED","TEAM_COMMAND_CONFLICT","TEAM_REVISION_CONFLICT","TEAM_ROUTE_PROFILE_MISMATCH","TEAM_REASONING_UNSUPPORTED","TEAM_FIT_UNQUALIFIED","TEAM_CONTEXT_REQUIRED_UNSUPPORTED","TEAM_CONTEXT_REQUIRED_TOO_LARGE","TEAM_PENDING_LIMIT","TEAM_BUDGET_EXHAUSTED","TEAM_WAIT_CYCLE","TEAM_EFFECTS_UNCERTAIN","TEAM_WAIT_INVALIDATED","TEAM_PROVIDER_REQUEST_REJECTED","TEAM_PROVIDER_STREAM_FAILED"]},"field":{"type":"string","minLength":1,"maxLength":2048},"retryable":{"type":"boolean"},"action":{"enum":["rebind","change-settings","reconcile","contact-operator","none"]},"protectedDiagnosticRef":{"$ref":"#/$defs/Id"}},"required":["code","retryable","action"],"additionalProperties":false},
    "ModelSettingsResult": {"oneOf":[{"type":"object","properties":{"disposition":{"const":"accepted"},"effective":{"$ref":"#/$defs/EffectiveModelReceipt"}},"required":["disposition","effective"],"additionalProperties":false},{"type":"object","properties":{"disposition":{"const":"refused"},"requested":{"$ref":"#/$defs/ModelSettingsRequest"},"diagnostic":{"$ref":"#/$defs/Diagnostic"}},"required":["disposition","requested","diagnostic"],"additionalProperties":false}]},
    "ProviderModelSettingsRecord": {"type":"object","properties":{"route":{"$ref":"#/$defs/RouteIdentity"},"pricingIdentity":{"$ref":"#/$defs/PricingIdentity"},"profile":{"$ref":"#/$defs/Ref"},"settingsRevision":{"$ref":"#/$defs/Revision"},"reasoning":{"$ref":"#/$defs/ReasoningRequest"}},"required":["route","profile","settingsRevision","reasoning"],"additionalProperties":false},
    "RebindModelRequest": {"type":"object","properties":{"commandId":{"$ref":"#/$defs/Id"},"bindingId":{"$ref":"#/$defs/Id"},"expectedBindingRevision":{"$ref":"#/$defs/Revision"},"route":{"$ref":"#/$defs/RouteIdentity"},"profile":{"$ref":"#/$defs/Ref"},"settingsRevision":{"$ref":"#/$defs/Revision"}},"required":["commandId","bindingId","expectedBindingRevision","route","profile","settingsRevision"],"additionalProperties":false},
    "TeamInstructions": {"type":"object","properties":{"revision":{"$ref":"#/$defs/Revision"},"digest":{"$ref":"#/$defs/Digest"},"text":{"type":"string","minLength":1,"maxLength":16384}},"required":["revision","digest","text"],"additionalProperties":false},
    "RosterMember": {"type":"object","properties":{"memberId":{"$ref":"#/$defs/Id"},"role":{"$ref":"#/$defs/Id"},"label":{"type":"string","minLength":1,"maxLength":256},"safeCapabilities":{"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"maxItems":32,"uniqueItems":true}},"required":["memberId","role","label","safeCapabilities"],"additionalProperties":false},
    "ContextSelection": {"type":"object","properties":{"sourceId":{"$ref":"#/$defs/Id"},"sourceKind":{"enum":["team-input","task-input","artifact","message","skill"]},"disposition":{"enum":["selected","excluded"]},"reasonCode":{"type":"string","minLength":1,"maxLength":512},"originalBytes":{"$ref":"#/$defs/Counter"},"selectedBytes":{"$ref":"#/$defs/Counter"},"truncated":{"type":"boolean"}},"required":["sourceId","sourceKind","disposition","originalBytes","selectedBytes","truncated"],"additionalProperties":false},
    "TeamContextReceipt": {"type":"object","properties":{"authority":{"$ref":"#/$defs/AttemptAuthority"},"teamInstructions":{"$ref":"#/$defs/TeamInstructions"},"instructionOrder":{"const":["host-policy","team-instructions","member-instructions","task-instructions"]},"self":{"$ref":"#/$defs/RosterMember"},"coordinatorMemberId":{"$ref":"#/$defs/Id"},"roster":{"type":"array","items":{"$ref":"#/$defs/RosterMember"},"minItems":0,"maxItems":16},"authorizationRevision":{"$ref":"#/$defs/Revision"},"selections":{"type":"array","items":{"$ref":"#/$defs/ContextSelection"},"minItems":0,"maxItems":128},"contextBudgetTokens":{"$ref":"#/$defs/Counter"},"countQuality":{"enum":["exact","conservative","unknown"]},"rootId":{"$ref":"#/$defs/Id"},"approvalScopeId":{"$ref":"#/$defs/Id"},"targetOutcomes":{"type":"array","items":{"$ref":"#/$defs/TargetOutcome"},"minItems":0,"maxItems":16},"targetOutcomeDataTrust":{"const":"untrusted-attributed-data"}},"required":["authority","instructionOrder","self","coordinatorMemberId","roster","authorizationRevision","selections","contextBudgetTokens","countQuality","rootId","approvalScopeId","targetOutcomes","targetOutcomeDataTrust"],"additionalProperties":false},
    "RosterRequest": {"type":"object","properties":{"cursor":{"type":"string","minLength":1,"maxLength":2048},"limit":{"type":"integer","minimum":1,"maximum":50}},"required":["limit"],"additionalProperties":false},
    "RosterResult": {"type":"object","properties":{"members":{"type":"array","items":{"$ref":"#/$defs/RosterMember"},"minItems":0,"maxItems":50},"authorizationRevision":{"$ref":"#/$defs/Revision"},"nextCursor":{"type":"string","minLength":1,"maxLength":2048}},"required":["members","authorizationRevision"],"additionalProperties":false},
    "Reservation": {"type":"object","properties":{"tokens":{"$ref":"#/$defs/Counter"},"costMicrounits":{"$ref":"#/$defs/Counter"},"elapsedSeconds":{"$ref":"#/$defs/Counter"}},"required":["tokens","costMicrounits","elapsedSeconds"],"additionalProperties":false},
    "DirectRecipient": {"type":"object","properties":{"memberId":{"$ref":"#/$defs/Id"},"taskId":{"$ref":"#/$defs/Id"}},"required":["memberId"],"additionalProperties":false},
    "AttributedPayload": {"type":"object","properties":{"text":{"type":"string","minLength":0,"maxLength":8192},"artifactIds":{"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"maxItems":16,"uniqueItems":true}},"required":["text","artifactIds"],"additionalProperties":false},
    "SendRequest": {"type":"object","properties":{"commandId":{"$ref":"#/$defs/Id"},"recipient":{"$ref":"#/$defs/DirectRecipient"},"payload":{"$ref":"#/$defs/AttributedPayload"}},"required":["commandId","recipient","payload"],"additionalProperties":false},
    "DelegateRequest": {"type":"object","properties":{"commandId":{"$ref":"#/$defs/Id"},"recipientMemberId":{"$ref":"#/$defs/Id"},"expectedTeamRevision":{"$ref":"#/$defs/Revision"},"task":{"type":"object","properties":{"taskId":{"$ref":"#/$defs/Id"},"role":{"$ref":"#/$defs/Id"},"input":{},"outputContract":{"type":["object","boolean"]},"dependsOn":{"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"maxItems":16,"uniqueItems":true}},"required":["taskId","role","input","outputContract","dependsOn"],"additionalProperties":false},"payload":{"$ref":"#/$defs/AttributedPayload"},"reservation":{"$ref":"#/$defs/Reservation"}},"required":["commandId","recipientMemberId","expectedTeamRevision","task","payload","reservation"],"additionalProperties":false},
    "CommandReceipt": {"type":"object","properties":{"commandId":{"$ref":"#/$defs/Id"},"requestDigest":{"$ref":"#/$defs/Digest"},"scope":{"$ref":"#/$defs/Scope"},"operation":{"enum":["team_send","team_delegate","team_wait"]},"senderMemberId":{"$ref":"#/$defs/Id"},"senderAttemptId":{"$ref":"#/$defs/Id"},"acceptedAt":{"$ref":"#/$defs/Instant"},"messageId":{"$ref":"#/$defs/Id"},"taskId":{"$ref":"#/$defs/Id"},"attemptId":{"$ref":"#/$defs/Id"},"waitId":{"$ref":"#/$defs/Id"}},"required":["commandId","requestDigest","scope","operation","senderMemberId","senderAttemptId","acceptedAt"],"additionalProperties":false},
    "MessageDelivery": {"type":"object","properties":{"messageId":{"$ref":"#/$defs/Id"},"recipientMemberId":{"$ref":"#/$defs/Id"},"recipientTaskId":{"$ref":"#/$defs/Id"},"status":{"enum":["accepted","delivered","consumed","rejected"]},"selectedAttemptId":{"$ref":"#/$defs/Id"},"selectedAt":{"$ref":"#/$defs/Instant"},"consumedAt":{"$ref":"#/$defs/Instant"},"rejectionCode":{"type":"string","minLength":1,"maxLength":512}},"required":["messageId","recipientMemberId","status"],"additionalProperties":false},
    "SendResult": {"type":"object","properties":{"receipt":{"$ref":"#/$defs/CommandReceipt"},"delivery":{"$ref":"#/$defs/MessageDelivery"}},"required":["receipt","delivery"],"additionalProperties":false},
    "DelegateResult": {"type":"object","properties":{"receipt":{"$ref":"#/$defs/CommandReceipt"},"delivery":{"$ref":"#/$defs/MessageDelivery"},"queuedAttemptId":{"$ref":"#/$defs/Id"}},"required":["receipt","delivery","queuedAttemptId"],"additionalProperties":false},
    "WaitRequest": {"type":"object","properties":{"commandId":{"$ref":"#/$defs/Id"},"targetTaskIds":{"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":1,"maxItems":16,"uniqueItems":true},"predicate":{"const":"all-terminal"},"continuationInput":{"$ref":"#/$defs/AttributedPayload"},"continuationReservation":{"$ref":"#/$defs/Reservation"}},"required":["commandId","targetTaskIds","predicate","continuationInput","continuationReservation"],"additionalProperties":false},
    "WaitAccepted": {"type":"object","properties":{"receipt":{"$ref":"#/$defs/CommandReceipt"},"waitId":{"$ref":"#/$defs/Id"},"state":{"const":"yield_requested"}},"required":["receipt","waitId","state"],"additionalProperties":false},
    "TargetOutcome": {"type":"object","properties":{"taskId":{"$ref":"#/$defs/Id"},"attemptId":{"$ref":"#/$defs/Id"},"executionOutcome":{"enum":["succeeded","failed","cancelled"]},"effectDisposition":{"const":"confirmed"},"artifactIds":{"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"maxItems":16,"uniqueItems":true},"memberId":{"$ref":"#/$defs/Id"}},"required":["taskId","attemptId","executionOutcome","effectDisposition","artifactIds","memberId"],"additionalProperties":false},
    "TeamWait": {"type":"object","properties":{"waitId":{"$ref":"#/$defs/Id"},"authority":{"$ref":"#/$defs/AttemptAuthority"},"targetTaskIds":{"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":1,"maxItems":16,"uniqueItems":true},"predicate":{"const":"all-terminal"},"continuationInput":{"$ref":"#/$defs/AttributedPayload"},"continuationReservation":{"$ref":"#/$defs/Reservation"},"state":{"enum":["yield_requested","waiting","blocked","resumed","invalidated"]},"continuationAttemptId":{"$ref":"#/$defs/Id"},"wakeOutcomes":{"type":"array","items":{"$ref":"#/$defs/TargetOutcome"},"minItems":0,"maxItems":16},"reasonCode":{"type":"string","minLength":1,"maxLength":512}},"required":["waitId","authority","targetTaskIds","predicate","continuationInput","continuationReservation","state","wakeOutcomes"],"additionalProperties":false},
    "KernelTeamYield": {"type":"object","properties":{"kind":{"const":"team-yield"},"waitId":{"$ref":"#/$defs/Id"},"yieldingAttemptId":{"$ref":"#/$defs/Id"},"durableReceiptId":{"$ref":"#/$defs/Id"},"remainingToolCalls":{"type":"array","items":{"type":"object","properties":{"toolCallId":{"$ref":"#/$defs/Id"},"disposition":{"const":"not-executed-due-to-yield"}},"required":["toolCallId","disposition"],"additionalProperties":false}}},"required":["kind","waitId","yieldingAttemptId","durableReceiptId","remainingToolCalls"],"additionalProperties":false},
    "ContinuationReceipt": {"type":"object","properties":{"waitId":{"$ref":"#/$defs/Id"},"uniquenessKey":{"type":"string","pattern":"^team-wait:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:continuation:1$"},"previousAttemptId":{"$ref":"#/$defs/Id"},"taskId":{"$ref":"#/$defs/Id"},"continuationAttemptId":{"$ref":"#/$defs/Id"},"runId":{"$ref":"#/$defs/Id"},"executionFence":{"$ref":"#/$defs/ExecutionFence"},"reservation":{"$ref":"#/$defs/Reservation"},"selectedArtifactIds":{"type":"array","items":{"$ref":"#/$defs/Id"},"minItems":0,"maxItems":16,"uniqueItems":true},"committedAt":{"$ref":"#/$defs/Instant"},"authority":{"$ref":"#/$defs/AttemptAuthority"},"rootId":{"$ref":"#/$defs/Id"},"approvalScopeId":{"$ref":"#/$defs/Id"},"authorizationRevision":{"$ref":"#/$defs/Revision"},"targetOutcomes":{"type":"array","items":{"$ref":"#/$defs/TargetOutcome"},"minItems":1,"maxItems":16}},"required":["waitId","uniquenessKey","previousAttemptId","taskId","continuationAttemptId","runId","executionFence","reservation","selectedArtifactIds","committedAt","authority","rootId","approvalScopeId","authorizationRevision","targetOutcomes"],"additionalProperties":false}
  }
