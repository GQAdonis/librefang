# Build
/target
crates/librefang-api/static/react/
/target-isolated
/target-*
**/*.rs.bk
*.pdb
dist
sdk/**/target
sdk/rust/Cargo.lock
# Default `rustc foo.rs` output when run without `-o` — never a tracked artifact.
/rust_out

# Mobile generated artifacts
crates/librefang-desktop/gen/apple/Externals/
crates/librefang-desktop/gen/apple/build/
crates/librefang-desktop/gen/android/.gradle/
crates/librefang-desktop/gen/android/build/
crates/librefang-desktop/gen/android/app/build/
crates/librefang-desktop/gen/android/local.properties

# Cloudflare Wrangler
.wrangler/
.serena
.vite

# Environment & secrets
.env
.env.*
!.env.example
secrets.env
secrets.env.*

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# User config (may contain API keys)
config.toml
# The managed-config overlay's config.toml is a committed manifest, not a user config: it is rendered into a ConfigMap, so a credential must never appear in it and scripts/check-k8s-manifests.py fails the build if one does.
# Without this negation the bare pattern above silently drops it, and the overlay fails to render on any fresh clone (#6695).
!deploy/kubernetes/overlays/managed-config/config.toml

# Certificates & keys
*.pem
*.key
*.cert
*.p12
*.pfx
# AUR CI deploy key pair (OpenSSH key has no extension, so *.pem / *.key miss it).
# Lives at the repo root for local AUR publishing; never commit it.
/aur_ci
/aur_ci.pub

# Runtime artifacts
collector_hand_state.json
collector_knowledge_base.json
predictions_database.json
prediction_report_*.md
BUILD_LOG.md
message_journal.jsonl

# KBD runtime-only state (canonical phase artifacts remain tracked)
.kbd-orchestrator/memory-outbox.jsonl
.kbd-orchestrator/model-preflight.json
.kbd-orchestrator/phases/**/hooks-status.json
.kbd-orchestrator/phases/**/hooks.log.jsonl
.kbd-orchestrator/phases/**/hooks.log.jsonl.lock

# Local working notes / design plans (ultrareview, brainstorm scratch)
.plans/

# Node.js (packages/)
node_modules/

# Python bytecode cache. Any `python3 scripts/tests/*.py` leaves one of these
# next to the source it imported, so without this every checkout that runs a
# test goes dirty with an untracked directory and no change to show for it.
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# Nix
result
.direnv/

# IDE & tools
.idea/
.vscode/
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/forbid-main-worktree.sh
!.claude/hooks/session-start-worktree-check.sh
!.claude/hooks/guard-bash-safety.sh
!.claude/hooks/lib/
.claude/hooks/lib/*
!.claude/hooks/lib/check-bash-rules.py
!.claude/prompts/
!.claude/prompts/*.md
!.claude/skills/
.claude/skills/*
!.claude/skills/librefang-upstream-merge/
!.claude/skills/librefang-upstream-merge/SKILL.md
!.claude/skills/librefang-upstream-merge/references/
!.claude/skills/librefang-upstream-merge/references/*.md
!.claude/skills/librefang-upstream-merge/scripts/
!.claude/skills/librefang-upstream-merge/scripts/*.sh
# bossfang-stewards agent team: native role definitions are shared (see .agent-team/).
!.claude/agents/
.claude/agents/*
!.claude/agents/product-manager.md
!.claude/agents/upstream-merge-manager.md
!.claude/agents/surrealdb-schema-engineer.md
!.claude/agents/bossfang-feature-steward.md
!.claude/agents/merge-reviewer.md
.codex/*
!.codex/agents/
.omc/
.qwen/
# OpenSpec generates per-tool instruction shims (slash commands + skills) into
# each agent tool's config dir. They are regenerated by `openspec init` /
# `openspec update`, so they stay local like every other agent-tool config here
# (`.claude/*` and `.codex` above). The shared artefact is `openspec/` itself,
# which IS tracked. See AGENTS.md → OpenSpec.
.opencode/*
!.opencode/agents/
.kimi/
# MiniMax: launch mcode with MINIMAX_DATA_DIR=<repo>/.minimax to load team agents;
# everything else mcode writes there (sessions, credentials) stays local.
.minimax/*
!.minimax/agents/
*.swp
*.swo
*~
.gitnexus
.todo_pak

# graphify knowledge-graph output (local-only, regenerable).
graphify-out/

# Python bytecode caches (scripts/test_enforce_branding.py et al.)
__pycache__/
*.pyc
.pnpm-store/
# Kustomize overlay generated by .github/workflows/kubernetes.yml's kind lane
# to retarget the image at a locally built tag. Must sit inside the repo tree
# because kustomize refuses an absolute resource root, so it lands here rather
# than in /tmp — but it is CI scratch, not a committed overlay.
deploy/kubernetes/ci-overlay/
deploy/kubernetes/ci-overlay-managed/
.agent-team/recovery/
